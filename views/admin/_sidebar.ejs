<aside class="sidebar">
  <a href="/admin" class="sidebar-brand" style="text-decoration:none;color:inherit;">
    <img src="/images/logo.jpg" alt="Living Dairies" class="sidebar-logo" />
    <div>
      <div class="sidebar-title">Living Dairies</div>
      <div class="sidebar-sub">Admin Console</div>
    </div>
  </a>

  <nav class="sidebar-nav">
    <div class="nav-section">Overview</div>
    <a href="/admin" class="nav-item <%= page === 'dashboard' ? 'active' : '' %>">
      <span class="dot dot-red"></span> Dashboard
    </a>

    <div class="nav-section">Operations</div>
    <a href="/admin/orders" class="nav-item <%= page === 'orders' ? 'active' : '' %>">
      <span class="dot dot-blue"></span> Active Orders
    </a>
    <a href="/admin/orders/completed" class="nav-item <%= page === 'completed' ? 'active' : '' %>">
      <span class="dot dot-green"></span> Completed
    </a>

    <div class="nav-section">Catalog</div>
    <a href="/admin/products" class="nav-item <%= page === 'products' ? 'active' : '' %>">
      <span class="dot dot-red"></span> Products
    </a>

    <div class="nav-section">Settings</div>
    <a href="/admin/notifications" class="nav-item <%= page === 'notifications' ? 'active' : '' %>">
      <span class="dot dot-blue"></span> Notifications
    </a>
    <% if (typeof adminRole !== 'undefined' && adminRole === 'super') { %>
      <a href="/admin/users" class="nav-item <%= page === 'users' ? 'active' : '' %>">
        <span class="dot dot-red"></span> Admin Users
      </a>
    <% } %>
  </nav>

  <div class="sidebar-foot">
    <div class="user-chip">
      <div class="user-avatar"><%= username.charAt(0).toUpperCase() %></div>
      <div>
        <div class="user-name"><%= username %></div>
        <div class="user-role">Administrator</div>
      </div>
    </div>
    <form action="/admin/logout" method="post">
      <button type="submit" class="logout-btn">Logout →</button>
    </form>
    <a href="/" target="_blank" class="view-site">View Public Site ↗</a>
  </div>
</aside>
