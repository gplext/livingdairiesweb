<% const title = 'Admin Users' %>
<%- include('_head', { title }) %>
<body>

<div class="layout">
  <%- include('_sidebar') %>

  <main class="main">
    <header class="page-head">
      <div>
        <span class="eyebrow">— Access Control</span>
        <h1 class="page-h1">Admin Users</h1>
      </div>
      <div class="page-head-meta">
        <span class="muted"><%= admins.length %> account<%= admins.length === 1 ? '' : 's' %></span>
      </div>
    </header>

    <%- include('_flash', { flash: typeof flash !== 'undefined' ? flash : null }) %>

    <div class="two-col">
      <!-- Admin list -->
      <section class="panel">
        <div class="panel-head">
          <div>
            <span class="eyebrow">— Accounts</span>
            <h2 class="panel-title">Who can access this console</h2>
          </div>
        </div>

        <div class="product-list">
          <% admins.forEach(function(a) { %>
            <div class="product-row">
              <div class="product-meta">
                <div class="product-name">
                  <%= a.username %>
                  <% if (a.id === currentId) { %><span class="muted" style="font-weight:normal;font-size:0.85em;"> — you</span><% } %>
                </div>
                <div class="product-desc">
                  <span class="status-pill <%= a.role === 'super' ? 'status-in_delivery' : 'status-pending' %>">
                    <%= a.role === 'super' ? 'Super Admin' : 'Admin' %>
                  </span>
                  <% if (!a.active) { %>
                    <span class="status-pill status-cancelled">Disabled</span>
                  <% } %>
                </div>
                <div class="product-id">
                  Last login: <%= a.last_login ? new Date(a.last_login + 'Z').toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) : 'never' %>
                </div>
              </div>

              <% if (a.id !== currentId) { %>
                <form action="/admin/users/<%= a.id %>/toggle" method="post">
                  <button type="submit" class="btn-icon" title="<%= a.active ? 'Disable account' : 'Enable account' %>">
                    <%= a.active ? '⏸' : '▶' %>
                  </button>
                </form>
                <form action="/admin/users/<%= a.id %>/delete" method="post"
                      onsubmit="return confirm('Delete admin &quot;<%= a.username %>&quot;? This cannot be undone.')">
                  <button type="submit" class="btn-icon btn-danger" title="Delete account">✕</button>
                </form>
              <% } %>
            </div>

            <!-- Reset password (collapsed) -->
            <details style="margin:-6px 0 14px 4px;">
              <summary class="muted" style="cursor:pointer;font-size:0.85em;">Reset password for <%= a.username %></summary>
              <form action="/admin/users/<%= a.id %>/password" method="post" class="form" style="margin-top:8px;">
                <div class="form-row">
                  <div class="form-group">
                    <input type="password" name="password" placeholder="New password (min 8 chars)" minlength="8" required />
                  </div>
                  <button type="submit" class="btn btn-ghost">Set Password</button>
                </div>
              </form>
            </details>
          <% }) %>
        </div>
      </section>

      <!-- Create admin -->
      <section class="panel">
        <div class="panel-head">
          <div>
            <span class="eyebrow">— Add New</span>
            <h2 class="panel-title">Create admin account</h2>
          </div>
        </div>

        <form action="/admin/users/add" method="post" class="form">
          <div class="form-group">
            <label for="username">Username</label>
            <input type="text" name="username" id="username" placeholder="e.g. tahira" pattern="[a-zA-Z0-9_.\-]{3,30}" required />
            <small class="hint">3–30 characters. Letters, numbers, _ . - only.</small>
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" placeholder="Minimum 8 characters" minlength="8" required />
            <small class="hint">Share it with the person privately. They can change it later from the dashboard.</small>
          </div>
          <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;font-weight:normal;">
              <input type="checkbox" name="role" value="super" style="width:auto;" />
              Make this account a Super Admin (can manage other admins)
            </label>
          </div>
          <button type="submit" class="btn btn-primary btn-block">Create Admin →</button>
        </form>
      </section>
    </div>
  </main>
</div>

</body>
</html>
